# Saltara needs no secret environment variables.
# Pose tracking runs in the browser: the MediaPipe WASM runtime loads from jsDelivr and the
# pose_landmarker_lite model from Google's public model bucket, with no key and no server.
# The class list is stored in the browser's localStorage.

# Data adapter: "fake" (default) serves the seeded fixtures; "real" is a Phase 2 stub.
ADAPTER_MODE=fake

# Set automatically by next.config.ts at build time (names of public/brand/*.png). Leave empty.
NEXT_PUBLIC_BRAND_FILES=
